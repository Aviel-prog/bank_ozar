@startuml Comprehensive_Bank_System

skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam shadowing true
skinparam packageStyle rectangle

' ==========================================
' Infrastructure & Database Domain
' ==========================================
package "Database Infrastructure" {
    class DbConnector {
        - connection_string : String
        - is_connected : Boolean
        + connect_to_db(db_file: String) : Boolean
        + close_connection() : void
        + get_user_information(username: String) : UserProfile
        + save_user_information(profile: UserProfile) : Boolean
    }

    class UserProfile {
        + username : String
        + account_id : String
        + created_at : DateTime
    }

    DbConnector ..> UserProfile : "retrieves & stores"
}

' ==========================================
' Core Business Domain (Bank Actions)
' ==========================================
package "Domain Services (Bank Actions)" {
    
    abstract class BankActions {
        # account_id : String
        # db : DbConnector
        + BankActions(account_id: String, db: DbConnector)
        + register_to_the_bank() : Boolean
        + delete_account() : Boolean
    }

    class MoneyActions {
        + add_money(amount: Float) : Float
        + pull_money(amount: Float) : Float
        + check_balance() : Float
    }

    class SubscriptionActions {
        - active_subscriptions : List<String>
        + add_subscription(service_name: String) : Boolean
        + remove_subscription(service_name: String) : Boolean
        + subscription_status() : List<String>
    }

    BankActions <|-- MoneyActions
    BankActions <|-- SubscriptionActions
    BankActions --> DbConnector : "uses for operations"
}

' ==========================================
' External Services
' ==========================================
package "External Services" {
    class CustomerServiceAPI << (S,#ADD8E6) Service >> {
        + {static} get_the_customers_list(url: String) : List<UserProfile>
        + {static} create_new_user(username: String) : UserProfile
    }
}

' ==========================================
' Controller & Application Orchestration
' ==========================================
package "Application Controller" {
    
    enum MenuOption {
        CHECK_BALANCE = 1
        ADD_MONEY = 2
        PULL_MONEY = 3
        SUBSCRIPTION_ACTION = 4
        DELETE_ACCOUNT = 5
        EXIT = 6
    }

    class ApplicationManager {
        - db : DbConnector
        - current_user : UserProfile
        - money_service : MoneyActions
        - sub_service : SubscriptionActions
        + run() : void
        - authenticate_user() : UserProfile
        - get_user_choice() : MenuOption
        - dispatch_action(choice: MenuOption) : void
    }

    ApplicationManager *-- DbConnector : "owns lifecycle"
    ApplicationManager o-- MoneyActions : "delegates to"
    ApplicationManager o-- SubscriptionActions : "delegates to"
    ApplicationManager ..> CustomerServiceAPI : "fetches data"
    ApplicationManager ..> MenuOption : "validates menu inputs"
}

' ==========================================
' Annotations & Documentation
' ==========================================
note top of ApplicationManager
  <b>Orchestrator:</b>
  Handles the application loop, menu navigation,
  user input validation, and service routing.
end note

note right of BankActions
  <b>Base Class:</b>
  Receives DbConnector via Dependency Injection
  to perform account-level operations.
end note

@enduml